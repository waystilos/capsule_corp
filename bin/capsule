#!/usr/bin/env python3
"""
Capsule Corp Cohort CLI (Unified Interface)
Built for Capsule Corp's own agent engineering system

Usage:
  capsule check [dir]       Run project checks (tests, linter, typechecker, secrets)
  capsule validate [idea]   Bulma & Hercule's pre-code demand & distribution validation gate
  capsule room [dir]        View Check-In Room (active agents, models, claimed files)
  capsule spy [dir]         King Kai's watchdog to detect agent scope drift & rogue edits
  capsule clock-in ...      Clock in to a work shift (auto-detects agent & claims files)
  capsule clock-out ...     Clock out of a work shift (summary & auto-prunes log)
  capsule heartbeat ...     Send heartbeat to keep active shift alive
  capsule list              List all registered cohort bots and their specs
  capsule route "request"   Route a request safely through the cohort
  capsule doctor [dir]      Run environment diagnostics and multi-AI healthcheck
  capsule scaffold ...      Dr. Gero's tool to create a new specialized agent
  capsule audit [--latest]  Dr. Gero's transcript auditor to detect friction & patch prompts
  capsule verify [dir]      Trunks' verification gate (tests + diff integrity check)
  capsule security [dir]    Android 17's security scan (secrets, CVEs, static code audit)
  capsule attack [dir]      Cell's adversarial red team attack scan (injection, SSRF, ReDoS, BOLA)
  capsule grill [dir]       Lord Beerus' architectural inquisition & code griller (swallowed errors, timeouts, edge cases)
  capsule init [dir]        Bootstrap any startup repo with Copilot, Codex, Claude, Gemini configs
  capsule sync              Sync skills and rules globally across all AIs
  capsule install-elixir    Install Elixir & Erlang/OTP globally across macOS, Linux, or Windows
  capsule test              Run unit tests for Capsule Corp scripts
"""

import os
import sys
import subprocess
from pathlib import Path

CAPSULE_ROOT = Path(__file__).resolve().parent.parent
SCRIPTS_DIR = CAPSULE_ROOT / "scripts"
CONFIG_DIR = CAPSULE_ROOT / "config"
REGISTRY_FILE = CAPSULE_ROOT / "registry.yaml"


def configure_utf8_stdio():
    for stream in (sys.stdout, sys.stderr):
        reconfigure = getattr(stream, "reconfigure", None)
        if reconfigure is not None:
            reconfigure(encoding="utf-8", errors="replace")


configure_utf8_stdio()


def cmd_list():
    if not REGISTRY_FILE.exists():
        print(f"Error: {REGISTRY_FILE} not found.", file=sys.stderr)
        sys.exit(1)

    try:
        import yaml
    except ImportError:
        yaml = None

    try:
        if yaml is None:
            raise ImportError
        data = yaml.safe_load(REGISTRY_FILE.read_text(encoding="utf-8"))
        if not isinstance(data, dict):
            raise ValueError("registry root must be a mapping")
    except ImportError:
        # Fallback simple line parser if pyyaml not installed
        print("Capsule Corp Cohort Registry:")
        for line in REGISTRY_FILE.read_text(encoding="utf-8").splitlines():
            print(f"  {line}")
        return 0
    except OSError as exc:
        print(f"Error: unable to read registry: {exc}", file=sys.stderr)
        return 1
    except (ValueError, yaml.YAMLError) as exc:
        print(f"Error: registry is invalid YAML: {exc}", file=sys.stderr)
        return 1

    bots = data.get("bots", {})
    print("==========================================================================================")
    print(" 🚀 CAPSULE CORP AGENT COHORT ROSTER")
    print("==========================================================================================")
    print(f"{'BOT ID':<16} | {'ALIAS':<32} | {'MODEL TIER':<10} | {'PRIMARY ROLE'}")
    print("-----------------+----------------------------------+------------+------------------------")
    for bot_id, details in bots.items():
        name = details.get("name", bot_id)
        alias = details.get("alias", name)
        tier = details.get("model_tier", "inherit")
        role = details.get("role", "")
        print(f"{name:<16} | {alias[:32]:<32} | {tier:<10} | {role}")
    print("==========================================================================================")
    print(f"Total Agents: {len(bots)} | Centralized at: {CAPSULE_ROOT}")
    return 0


def cmd_route(args):
    script = SCRIPTS_DIR / "route_request.py"
    return run_child([sys.executable, str(script)] + args)


def cmd_doctor(args):
    script = SCRIPTS_DIR / "doctor.py"
    return run_child([sys.executable, str(script)] + args)


def run_child(command):
    """Run a delegated command and preserve its exit status."""
    env = os.environ.copy()
    env["PYTHONIOENCODING"] = "utf-8"
    return subprocess.run(command, env=env).returncode


def cmd_scaffold(args):
    script = SCRIPTS_DIR / "scaffold_bot.py"
    return run_child([sys.executable, str(script)] + args)


def cmd_audit(args):
    script = SCRIPTS_DIR / "audit_transcripts.py"
    return run_child([sys.executable, str(script)] + args)


def cmd_check(args):
    script = SCRIPTS_DIR / "check_project.py"
    return run_child([sys.executable, str(script)] + args)


def cmd_room(action, args):
    script = SCRIPTS_DIR / "room.py"
    return run_child([sys.executable, str(script), action] + args)


def cmd_validate(args):
    script = SCRIPTS_DIR / "validate_idea.py"
    return run_child([sys.executable, str(script)] + args)


def cmd_spy(args):
    script = SCRIPTS_DIR / "spy_watchdog.py"
    return run_child([sys.executable, str(script)] + args)


def cmd_verify(args):
    script = SCRIPTS_DIR / "verify_project.py"
    return run_child([sys.executable, str(script)] + args)


def cmd_security(args):
    script = SCRIPTS_DIR / "security_audit.py"
    return run_child([sys.executable, str(script)] + args)


def cmd_attack(args):
    script = SCRIPTS_DIR / "red_team.py"
    return run_child([sys.executable, str(script)] + args)


def cmd_grill(args):
    script = SCRIPTS_DIR / "grill_code.py"
    return run_child([sys.executable, str(script)] + args)


def cmd_init(args):
    script = SCRIPTS_DIR / "init_project.py"
    return run_child([sys.executable, str(script)] + args)


def cmd_sync(args):
    script = CONFIG_DIR / "sync_all_ais.sh"
    return run_child(["bash", str(script)] + args)


def cmd_install_elixir(args):
    script = SCRIPTS_DIR / "install_elixir.py"
    return run_child([sys.executable, str(script)] + args)


def cmd_test():
    test_dir = CAPSULE_ROOT / "tests"
    return subprocess.run(
        [sys.executable, "-m", "unittest", "discover", "-s", str(test_dir), "-p", "test_*.py", "-v"],
        cwd=str(CAPSULE_ROOT)
    ).returncode


def main():
    if len(sys.argv) < 2 or sys.argv[1] in ["-h", "--help"]:
        print(__doc__)
        sys.exit(0)

    subcommand = sys.argv[1]
    extra_args = sys.argv[2:]

    if subcommand == "check":
        exit_code = cmd_check(extra_args)
    elif subcommand == "validate":
        exit_code = cmd_validate(extra_args)
    elif subcommand in ("room", "conference"):
        exit_code = cmd_room("status", extra_args)
    elif subcommand in ("spy", "watchdog"):
        exit_code = cmd_spy(extra_args)
    elif subcommand == "clock-in":
        exit_code = cmd_room("clock-in", extra_args)
    elif subcommand == "clock-out":
        exit_code = cmd_room("clock-out", extra_args)
    elif subcommand in ("heartbeat", "touch"):
        exit_code = cmd_room("heartbeat", extra_args)
    elif subcommand == "list":
        exit_code = cmd_list()
    elif subcommand == "route":
        exit_code = cmd_route(extra_args)
    elif subcommand == "doctor":
        exit_code = cmd_doctor(extra_args)
    elif subcommand == "scaffold":
        exit_code = cmd_scaffold(extra_args)
    elif subcommand == "audit":
        exit_code = cmd_audit(extra_args)
    elif subcommand == "verify":
        exit_code = cmd_verify(extra_args)
    elif subcommand == "security":
        exit_code = cmd_security(extra_args)
    elif subcommand in ("attack", "redteam"):
        exit_code = cmd_attack(extra_args)
    elif subcommand in ("grill", "inquisition"):
        exit_code = cmd_grill(extra_args)
    elif subcommand == "init":
        exit_code = cmd_init(extra_args)
    elif subcommand == "sync":
        exit_code = cmd_sync(extra_args)
    elif subcommand in ("install-elixir", "setup-elixir"):
        exit_code = cmd_install_elixir(extra_args)
    elif subcommand == "test":
        exit_code = cmd_test()
    else:
        print(f"Unknown subcommand: '{subcommand}'\n", file=sys.stderr)
        print(__doc__)
        sys.exit(1)

    sys.exit(exit_code)


if __name__ == "__main__":
    main()
