#!/usr/bin/env bash
set -e

DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
BIN="$DIR/bin/capsule-go"

if [ -f "$BIN.exe" ]; then
    BIN="$BIN.exe"
elif [ ! -f "$BIN" ]; then
    (cd "$DIR" && go build -o "$BIN" ./cmd/capsule)
    if [ -f "$BIN.exe" ]; then
        BIN="$BIN.exe"
    fi
fi

exec "$BIN" "$@"
